<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/screen_margin_vertical">

        <!-- Shimmer: Greeting Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_large">

            <!-- Avatar circle -->
            <View
                android:layout_width="@dimen/avatar_medium"
                android:layout_height="@dimen/avatar_medium"
                android:background="@drawable/shimmer_circle"
                android:layout_marginEnd="@dimen/spacing_medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="180dp"
                    android:layout_height="20dp"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:background="@drawable/shimmer_placeholder" />

            </LinearLayout>

            <!-- Score badge -->
            <View
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/shimmer_placeholder" />

        </LinearLayout>

        <!-- Shimmer: Active Trip Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_small"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Status badge row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="22dp"
                        android:background="@drawable/shimmer_placeholder" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="14dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

                <!-- Route lines -->
                <View
                    android:layout_width="60dp"
                    android:layout_height="10dp"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="10dp"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <View
                    android:layout_width="200dp"
                    android:layout_height="16dp"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <!-- Metrics row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/shimmer_placeholder"
                            android:layout_marginBottom="@dimen/spacing_xxs" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="14dp"
                            android:background="@drawable/shimmer_placeholder" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/shimmer_placeholder"
                            android:layout_marginBottom="@dimen/spacing_xxs" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="14dp"
                            android:background="@drawable/shimmer_placeholder" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/shimmer_placeholder"
                            android:layout_marginBottom="@dimen/spacing_xxs" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="14dp"
                            android:background="@drawable/shimmer_placeholder" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Action button -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/shimmer_placeholder" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Shimmer: Vehicle Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_xs"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:background="@drawable/shimmer_placeholder"
                    android:layout_marginEnd="@dimen/spacing_medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="140dp"
                        android:layout_height="16dp"
                        android:background="@drawable/shimmer_placeholder"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Shimmer: Today Summary -->
        <View
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:background="@drawable/shimmer_placeholder"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_small">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/card_padding">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/shimmer_circle"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:background="@drawable/shimmer_placeholder"
                        android:layout_marginBottom="@dimen/spacing_xxs" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/card_padding">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/shimmer_circle"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:background="@drawable/shimmer_placeholder"
                        android:layout_marginBottom="@dimen/spacing_xxs" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/card_padding">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/shimmer_circle"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:background="@drawable/shimmer_placeholder"
                        android:layout_marginBottom="@dimen/spacing_xxs" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/card_padding">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/shimmer_circle"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:background="@drawable/shimmer_placeholder"
                        android:layout_marginBottom="@dimen/spacing_xxs" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:background="@drawable/shimmer_placeholder" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
