<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDriver"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_xs"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Top Row: Avatar + Name + Verification Badge + Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Driver Avatar -->
            <FrameLayout
                android:layout_width="@dimen/avatar_medium"
                android:layout_height="@dimen/avatar_medium">

                <ImageView
                    android:id="@+id/ivDriverAvatar"
                    android:layout_width="@dimen/avatar_medium"
                    android:layout_height="@dimen/avatar_medium"
                    android:src="@drawable/ic_account_circle"
                    android:contentDescription="@string/cd_driver_avatar"
                    app:tint="@color/text_hint" />

                <!-- Status Dot -->
                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_status_dot" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_small">

                <!-- Driver Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDriverName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Rahul Sharma" />

                    <!-- Verified Icon -->
                    <ImageView
                        android:id="@+id/ivVerifiedBadge"
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:layout_marginStart="@dimen/spacing_xxs"
                        android:src="@drawable/ic_verified"
                        android:contentDescription="@string/cd_verified_badge"
                        app:tint="@color/status_approved"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- License + Contact -->
                <TextView
                    android:id="@+id/tvDriverInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="DL-0420110012345 · O+" />

            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="@dimen/spacing_xxs"
                android:textSize="@dimen/text_overline"
                android:fontFamily="sans-serif-medium"
                tools:text="Approved"
                tools:textColor="@color/status_approved" />

            <!-- Options Menu -->
            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="@dimen/icon_medium"
                android:layout_height="@dimen/icon_medium"
                android:layout_marginStart="@dimen/spacing_xs"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="@string/cd_driver_options"
                app:tint="@color/text_hint"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_small"
            android:background="@color/divider" />

        <!-- Stats Row: Rating + Total Trips + Vehicle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_label_rating"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        tools:text="4.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ★"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/star_filled" />

                </LinearLayout>

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/divider" />

            <!-- Trips -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_label_trips"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvTrips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    tools:text="142" />

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/divider" />

            <!-- Vehicle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_label_vehicle"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="MH02AB1234" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/driver_action_verify"
                android:textSize="@dimen/text_caption"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_verified"
                app:iconSize="16dp"
                app:cornerRadius="@dimen/radius_small"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlock"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/driver_action_block"
                android:textSize="@dimen/text_caption"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_block"
                app:iconSize="16dp"
                app:cornerRadius="@dimen/radius_small"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssignVehicle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/driver_action_assign_vehicle"
                android:textSize="@dimen/text_caption"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_local_shipping"
                app:iconSize="16dp"
                app:cornerRadius="@dimen/radius_small"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
