<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- ═══════════════════════════════════════════════
         TIMELINE CONNECTOR (Dot + Lines)
         ═══════════════════════════════════════════════ -->

    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top line (hidden for first item) -->
        <View
            android:id="@+id/lineTop"
            android:layout_width="2.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/public_timeline_line" />

        <!-- Dot — background set dynamically based on completion state -->
        <View
            android:id="@+id/dotEvent"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_timeline_dot_pending" />

        <!-- Bottom line (hidden for last item) -->
        <View
            android:id="@+id/lineBottom"
            android:layout_width="2.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/public_timeline_line" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         EVENT CONTENT
         ═══════════════════════════════════════════════ -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:paddingVertical="6dp">

        <!-- Event title -->
        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/public_text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="Pickup Completed" />

        <!-- Event description -->
        <TextView
            android:id="@+id/tvEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/public_text_secondary"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone"
            tools:text="Your package has been picked up and is on the way"
            tools:visibility="visible" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvEventTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/public_text_hint"
            android:layout_marginTop="3dp"
            android:visibility="gone"
            tools:text="Jan 15, 2026 · 10:30 AM"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
