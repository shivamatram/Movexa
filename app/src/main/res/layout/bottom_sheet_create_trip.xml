<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin_horizontal">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_create_title"
            android:textSize="@dimen/text_title"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trip_create_subtitle"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- Pickup Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPickupAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="@color/primary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPickupAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/trip_pickup_address"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Drop Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDropAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:startIconDrawable="@drawable/ic_flag"
            app:startIconTint="@color/error"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDropAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/trip_drop_address"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Load Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLoadDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:startIconDrawable="@drawable/ic_local_shipping"
            app:startIconTint="@color/text_secondary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoadDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/trip_load_description"
                android:inputType="textMultiLine"
                android:maxLines="2"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Estimated Distance -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEstimatedDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:startIconDrawable="@drawable/ic_straighten"
            app:startIconTint="@color/text_secondary"
            app:suffixText="km"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEstimatedDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/trip_estimated_distance"
                android:inputType="numberDecimal"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:startIconDrawable="@drawable/ic_edit"
            app:startIconTint="@color/text_secondary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/trip_notes"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_small"
                android:text="@android:string/cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateTrip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/trip_create_title"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- Loading indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_surface" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
