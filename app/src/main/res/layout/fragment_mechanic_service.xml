<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══ LOADING STATE ═══ -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_container" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/maint_loading"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- ═══ ERROR STATE ═══ -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/screen_margin_horizontal"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icon_xl"
            android:layout_height="@dimen/icon_xl"
            android:src="@drawable/ic_maint_warning"
            android:contentDescription="@string/cd_maint_error"
            app:tint="@color/error" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/maint_error_title"
            android:textSize="@dimen/text_subtitle"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/maint_error_retry"
            style="@style/Widget.Movexa.Button.Secondary" />
    </LinearLayout>

    <!-- ═══ READY / MAIN CONTENT ═══ -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin_horizontal">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maint_service_header"
                android:textAppearance="@style/TextAppearance.Movexa.SectionHeader"
                android:layout_marginBottom="@dimen/spacing_xxs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maint_service_desc"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <!-- ═══ VEHICLE SELECTOR CARD ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVehicleSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_small"
                app:cardBackgroundColor="@color/maint_vehicle_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/maint_select_vehicle"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        app:boxCornerRadiusTopStart="@dimen/radius_small"
                        app:boxCornerRadiusTopEnd="@dimen/radius_small"
                        app:boxCornerRadiusBottomStart="@dimen/radius_small"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_small">

                        <AutoCompleteTextView
                            android:id="@+id/actvVehicle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:text="MH 12 AB 1234 (TRUCK)" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Vehicle Info Row -->
                    <LinearLayout
                        android:id="@+id/layoutVehicleInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvVehicleStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/maint_vehicle_status_available"
                            tools:text="Status: AVAILABLE" />

                        <TextView
                            android:id="@+id/tvVehicleOdometer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_secondary"
                            tools:text="Odometer: 45,000 km" />

                    </LinearLayout>

                    <!-- Quick Actions -->
                    <LinearLayout
                        android:id="@+id/layoutQuickActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetInService"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_small"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:text="@string/maint_set_in_service"
                            android:textSize="@dimen/text_overline"
                            style="@style/Widget.Material3.Button.TonalButton"
                            app:backgroundTint="@color/maint_action_service" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetAvailable"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height_small"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/maint_set_available"
                            android:textSize="@dimen/text_overline"
                            style="@style/Widget.Material3.Button.TonalButton"
                            app:backgroundTint="@color/maint_action_available" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ NO VEHICLE SELECTED ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_xs"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_variant"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xxl"
                    android:text="@string/maint_no_vehicle_selected"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_hint"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ SERVICE FORM ═══ -->
            <LinearLayout
                android:id="@+id/layoutServiceForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Service Type -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilServiceType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/maint_service_type"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="@dimen/radius_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_small"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_small">

                    <AutoCompleteTextView
                        android:id="@+id/actvServiceType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Default Interval Hint -->
                <TextView
                    android:id="@+id/tvDefaultInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_hint"
                    android:visibility="gone"
                    tools:text="Default interval: 5,000 km"
                    tools:visibility="visible" />

                <!-- Odometer -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/maint_odometer"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    style="@style/Widget.Movexa.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOdometer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Next Service Preview -->
                <LinearLayout
                    android:id="@+id/layoutNextService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_next_service"
                    android:padding="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/icon_medium"
                        android:layout_height="@dimen/icon_medium"
                        android:src="@drawable/ic_maint_check"
                        android:contentDescription="@string/cd_maint_status_icon"
                        app:tint="@color/maint_next_service_text"
                        android:layout_marginEnd="@dimen/spacing_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/maint_next_service"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/maint_next_service_text"
                        android:layout_marginEnd="@dimen/spacing_xs" />

                    <TextView
                        android:id="@+id/tvNextServiceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/maint_next_service_text"
                        android:fontFamily="sans-serif-medium"
                        tools:text="50,000 km" />

                </LinearLayout>

                <!-- Cost -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/maint_cost"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    style="@style/Widget.Movexa.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/maint_description"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    style="@style/Widget.Movexa.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Workshop -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWorkshop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/maint_workshop"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    style="@style/Widget.Movexa.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkshop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mark Completed -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maint_mark_completed"
                    android:checked="true"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <!-- Validation Error -->
                <TextView
                    android:id="@+id/tvValidationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="Please enter valid odometer"
                    tools:visibility="visible" />

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitService"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/maint_submit_service"
                    android:contentDescription="@string/cd_maint_submit"
                    style="@style/Widget.Movexa.Button.Primary"
                    app:backgroundTint="@color/maint_submit_bg"
                    android:layout_marginBottom="@dimen/spacing_large" />

            </LinearLayout>

            <!-- ═══ MAINTENANCE OVERVIEW ═══ -->
            <LinearLayout
                android:id="@+id/layoutMaintenanceOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maint_maintenance_overview"
                    android:textAppearance="@style/TextAppearance.Movexa.SectionHeader"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMaintenanceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/spacing_medium" />

            </LinearLayout>

            <!-- ═══ RECENT SERVICES ═══ -->
            <LinearLayout
                android:id="@+id/layoutRecentServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maint_recent_services"
                    android:textAppearance="@style/TextAppearance.Movexa.SectionHeader"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentServices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/spacing_large" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tvNoRecentServices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maint_no_recent_services"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:padding="@dimen/spacing_large"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
