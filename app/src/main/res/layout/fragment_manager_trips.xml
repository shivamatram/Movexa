<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">

        <!-- Header with title + summary counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_management_title"
                        android:textSize="@dimen/text_headline"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvTripsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_management_subtitle"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/spacing_xxs" />

                </LinearLayout>

                <!-- Trip count badge -->
                <TextView
                    android:id="@+id/tvTotalTripCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_trip_status_badge"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    tools:text="12 trips" />

            </LinearLayout>

            <!-- Summary counts row -->
            <LinearLayout
                android:id="@+id/layoutTripCounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvUnassignedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/trip_created"
                    android:drawablePadding="@dimen/spacing_xs"
                    tools:text="3 Unassigned" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/tvOngoingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/trip_started"
                    android:drawablePadding="@dimen/spacing_xs"
                    tools:text="5 Ongoing" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="@dimen/spacing_small" />

                <TextView
                    android:id="@+id/tvCompletedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/trip_completed"
                    android:drawablePadding="@dimen/spacing_xs"
                    tools:text="24 Completed" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/white"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_secondary"
            app:tabRippleColor="@color/primary_surface"
            app:tabTextAppearance="@style/TextAppearance.Movexa.TabLabel" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Tab Content Container -->
    <FrameLayout
        android:id="@+id/tripTabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- FAB for creating new trip -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_medium"
        android:contentDescription="@string/trip_create_title"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
