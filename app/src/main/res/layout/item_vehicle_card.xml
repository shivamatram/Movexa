<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVehicle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_xs"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Top Row: Vehicle Number + Status Badge + Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Vehicle Type Icon -->
            <ImageView
                android:id="@+id/ivVehicleType"
                android:layout_width="@dimen/avatar_small"
                android:layout_height="@dimen/avatar_small"
                android:src="@drawable/ic_local_shipping"
                android:contentDescription="@string/cd_vehicle_icon"
                app:tint="@color/primary"
                android:background="@color/primary_surface"
                android:padding="@dimen/spacing_xs" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_small">

                <!-- Vehicle Number -->
                <TextView
                    android:id="@+id/tvVehicleNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="MH 02 AB 1234" />

                <!-- Vehicle Type + Make/Model -->
                <TextView
                    android:id="@+id/tvVehicleDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="SUV · Toyota Fortuner 2023" />

            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="@dimen/spacing_xxs"
                android:textSize="@dimen/text_overline"
                android:fontFamily="sans-serif-medium"
                tools:text="Available"
                tools:textColor="@color/status_available" />

            <!-- Options Menu -->
            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="@dimen/icon_medium"
                android:layout_height="@dimen/icon_medium"
                android:layout_marginStart="@dimen/spacing_xs"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="@string/cd_vehicle_options"
                app:tint="@color/text_hint"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_small"
            android:background="@color/divider" />

        <!-- Info Row: Capacity + Driver Assignment + Odometer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Capacity -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_label_capacity"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    tools:text="7" />

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/divider" />

            <!-- Driver -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_label_driver"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvDriver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Assigned" />

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/divider" />

            <!-- Docs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_label_docs"
                    android:textSize="@dimen/text_overline"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Valid"
                    tools:textColor="@color/success" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_small">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssignDriver"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/vehicle_assign_driver"
                android:textSize="@dimen/text_caption"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_person"
                app:iconSize="16dp"
                app:cornerRadius="@dimen/radius_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditVehicle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/action_edit"
                android:textSize="@dimen/text_caption"
                style="@style/Widget.Material3.Button.TonalButton"
                app:icon="@drawable/ic_edit"
                app:iconSize="16dp"
                app:cornerRadius="@dimen/radius_small" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
