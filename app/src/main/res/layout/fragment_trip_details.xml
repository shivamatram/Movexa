<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/elevation_small"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin_horizontal">

                <!-- Back + Title row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:contentDescription="@string/cd_back"
                        app:tint="@color/text_primary"
                        android:padding="6dp" />

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/trip_details_title"
                        android:textSize="@dimen/text_title"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <ImageButton
                        android:id="@+id/btnRefresh"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_refresh"
                        android:contentDescription="@string/cd_refresh"
                        app:tint="@color/text_secondary"
                        android:padding="6dp" />

                </LinearLayout>

                <!-- Status + Tracking ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_trip_status_badge"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        tools:text="STARTED" />

                    <TextView
                        android:id="@+id/tvTrackingId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_hint"
                        android:fontFamily="monospace"
                        tools:text="TRK-20250101-A1B2C3" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Map Placeholder -->
        <FrameLayout
            android:id="@+id/layoutMapPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_map_placeholder">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_map"
                    android:contentDescription="@string/trip_map_placeholder"
                    app:tint="@color/text_hint"
                    android:alpha="0.5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/trip_map_placeholder"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

        </FrameLayout>

        <!-- Route Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRouteInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_small"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Section title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_route_info"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <!-- Route visualization -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Route dots and line -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="@dimen/spacing_medium">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_timeline_dot" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@color/timeline_line"
                            android:layout_marginVertical="2dp" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/bg_timeline_dot" />

                    </LinearLayout>

                    <!-- Addresses -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Pickup -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="@dimen/spacing_large">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trip_pickup_label"
                                android:textSize="10sp"
                                android:textColor="@color/text_hint"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvPickupAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp"
                                tools:text="123 Industrial Area, Phase 2, Mumbai, Maharashtra 400001" />

                        </LinearLayout>

                        <!-- Drop -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trip_drop_label"
                                android:textSize="10sp"
                                android:textColor="@color/text_hint"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvDropAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp"
                                tools:text="456 Warehouse District, Pune, Maharashtra 411001" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Distance & Duration row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_distance"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_subtitle"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="350 km" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_duration"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_subtitle"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="5h 30m" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Trip Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTripInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_small"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_info_section"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <!-- Load Description -->
                <LinearLayout
                    android:id="@+id/layoutLoadDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_local_shipping"
                        android:contentDescription="@string/cd_vehicle"
                        app:tint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_load_description"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvLoadDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="20 Tons Steel Bars" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Vehicle -->
                <LinearLayout
                    android:id="@+id/layoutVehicleDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_dashboard_vehicle"
                        android:contentDescription="@string/cd_vehicle"
                        app:tint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_assign_vehicle"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvVehicleDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="MH-12-AB-1234 (Truck)" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Driver -->
                <LinearLayout
                    android:id="@+id/layoutDriverDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@string/cd_driver_info"
                        app:tint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_assign_driver"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvDriverDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="Rajesh Kumar" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Assigned By -->
                <LinearLayout
                    android:id="@+id/layoutAssignedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_assignment"
                        android:contentDescription="@string/cd_assigned_by"
                        app:tint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_assigned_by"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvAssignedBy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="Manager Priya" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Notes -->
                <LinearLayout
                    android:id="@+id/layoutNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_edit"
                        android:contentDescription="@string/trip_notes"
                        app:tint="@color/text_hint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_notes"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="Handle with care, fragile cargo" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Timestamps -->
                <View
                    android:id="@+id/dividerTimestamps"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="@dimen/spacing_small"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutTimestamps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_start_time"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="Jan 15, 10:30 AM" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutEndTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_end_time"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_hint" />

                        <TextView
                            android:id="@+id/tvEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            tools:text="Jan 15, 4:00 PM" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Timeline Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_small"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_timeline_section"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_medium" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_timeline_event"
                    tools:itemCount="4" />

                <!-- Empty timeline state -->
                <TextView
                    android:id="@+id/tvNoTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_empty_timeline"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:paddingVertical="@dimen/spacing_large"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons at bottom -->
        <LinearLayout
            android:id="@+id/layoutDetailActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_margin_horizontal"
            android:paddingVertical="@dimen/spacing_medium"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_small"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                tools:text="Cancel Trip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.Button"
                tools:text="Start Trip" />

        </LinearLayout>

        <!-- Loading overlay -->
        <FrameLayout
            android:id="@+id/layoutDetailLoading"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/primary" />

        </FrameLayout>

        <!-- Bottom spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xl" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
