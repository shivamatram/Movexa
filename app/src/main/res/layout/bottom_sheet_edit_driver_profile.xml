<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_edit_profile_title"
        android:textSize="@dimen/text_title"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvEditSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_edit_profile_subtitle"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/spacing_large" />

    <!-- Full Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/edit_profile_name_hint"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="John Doe" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Phone Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/edit_profile_phone_hint"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="+91 98765 43210" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Emergency Contact Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditEmergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/driver_emergency_contact_hint"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/error"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="+91 11111 22222" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Blood Group Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditBloodGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/driver_blood_group_hint"
        app:startIconDrawable="@drawable/ic_info"
        app:startIconTint="@color/error"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"
            tools:text="O+" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/edit_profile_save"
        style="@style/Widget.Movexa.Button.Primary"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelEdit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/edit_profile_cancel"
        style="@style/Widget.Movexa.Button.Text"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressEditProfile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loading_bar_height"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/primary_surface"
        tools:visibility="visible" />

</LinearLayout>
