<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/public_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- ═══════════════════════════════════════════════
                 HEADER / HERO SECTION
                 ═══════════════════════════════════════════════ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="56dp"
                android:paddingBottom="32dp"
                android:paddingHorizontal="24dp">

                <!-- Delivery icon -->
                <ImageView
                    android:id="@+id/ivHeroIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_public_delivery"
                    app:tint="@color/public_primary"
                    android:contentDescription="@string/cd_public_track_icon" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/public_enter_title"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/public_text_primary"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/public_enter_subtitle"
                    android:textSize="15sp"
                    android:textColor="@color/public_text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingHorizontal="16dp" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════
                 SEARCH INPUT CARD
                 ═══════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/public_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Input field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTrackingId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="@color/public_primary"
                        app:hintTextColor="@color/public_primary"
                        app:startIconDrawable="@drawable/ic_public_search"
                        app:startIconTint="@color/public_text_hint"
                        app:helperText="@string/public_enter_input_helper"
                        app:helperTextTextColor="@color/public_text_hint"
                        app:errorEnabled="true"
                        android:hint="@string/public_enter_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTrackingId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:imeOptions="actionSearch"
                            android:textSize="18sp"
                            android:textColor="@color/public_text_primary"
                            android:letterSpacing="0.05" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Track button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrack"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/public_enter_track_button"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/public_primary"
                        android:textColor="@color/public_on_primary"
                        app:icon="@drawable/ic_public_search"
                        app:iconGravity="textStart"
                        app:iconTint="@color/public_on_primary"
                        app:iconPadding="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════
                 ERROR STATE
                 ═══════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/public_error_bg"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/ivErrorIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cloud_off"
                        app:tint="@color/public_error_red"
                        android:contentDescription="@string/cd_public_status_icon" />

                    <TextView
                        android:id="@+id/tvErrorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/public_error_red"
                        android:gravity="center"
                        tools:text="Tracking ID Not Found" />

                    <TextView
                        android:id="@+id/tvErrorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="13sp"
                        android:textColor="@color/public_text_secondary"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        tools:text="We couldn't find a delivery matching this ID." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/public_error_try_again"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════
                 LOADING STATE
                 ═══════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressLoading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/public_primary"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tvLoadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/public_loading"
                    android:textSize="14sp"
                    android:textColor="@color/public_text_secondary" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════
                 RECENT SEARCHES SECTION
                 ═══════════════════════════════════════════════ -->

            <LinearLayout
                android:id="@+id/layoutRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:paddingHorizontal="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_public_history"
                        app:tint="@color/public_text_secondary"
                        android:contentDescription="@string/cd_public_recent_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/public_enter_recent_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/public_text_secondary" />

                    <TextView
                        android:id="@+id/tvClearAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/public_enter_clear_all"
                        android:textSize="13sp"
                        android:textColor="@color/public_primary"
                        android:padding="4dp" />

                </LinearLayout>

                <!-- Recent search list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentSearches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_recent_search"
                    tools:itemCount="3" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════
                 FOOTER
                 ═══════════════════════════════════════════════ -->

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:text="@string/public_enter_powered_by"
                android:textSize="12sp"
                android:textColor="@color/public_text_hint"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
