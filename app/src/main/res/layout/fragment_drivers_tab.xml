<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Search Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                    android:layout_marginTop="@dimen/spacing_medium"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="@dimen/elevation_xs"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/spacing_medium">

                        <ImageView
                            android:layout_width="@dimen/icon_medium"
                            android:layout_height="@dimen/icon_medium"
                            android:src="@drawable/ic_search"
                            android:contentDescription="@string/cd_search"
                            app:tint="@color/text_hint" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:background="@android:color/transparent"
                            android:hint="@string/fleet_search_drivers"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:maxLines="1"
                            android:importantForAutofill="no" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Status Filter Chips -->
                <HorizontalScrollView
                    android:id="@+id/chipScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal"
                    android:clipToPadding="false">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:checkedChip="@id/chipAll"
                        app:chipSpacingHorizontal="@dimen/spacing_small">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_all"
                            style="@style/Widget.Material3.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_background"
                            app:checkedIconEnabled="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_active"
                            style="@style/Widget.Material3.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_background"
                            app:checkedIconEnabled="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_pending"
                            style="@style/Widget.Material3.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_background"
                            app:checkedIconEnabled="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_blocked"
                            style="@style/Widget.Material3.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_background"
                            app:checkedIconEnabled="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUnassigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_unassigned"
                            style="@style/Widget.Material3.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_background"
                            app:checkedIconEnabled="false" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- Driver Count Header -->
                <LinearLayout
                    android:id="@+id/layoutDriverCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal"
                    android:paddingVertical="@dimen/spacing_small">

                    <TextView
                        android:id="@+id/tvDriverCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        tools:text="8 drivers" />

                </LinearLayout>

                <!-- Loading Shimmer -->
                <LinearLayout
                    android:id="@+id/layoutShimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <include layout="@layout/item_vehicle_card_shimmer" />
                    <include layout="@layout/item_vehicle_card_shimmer" />
                    <include layout="@layout/item_vehicle_card_shimmer" />

                </LinearLayout>

                <!-- Driver List Container -->
                <LinearLayout
                    android:id="@+id/layoutDriverList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal"
                    android:paddingBottom="80dp"
                    android:clipToPadding="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xxl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/icon_xl"
                        android:layout_height="@dimen/icon_xl"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@string/cd_driver_icon"
                        app:tint="@color/text_disabled"
                        android:layout_marginBottom="@dimen/spacing_medium" />

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fleet_no_drivers"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fleet_no_drivers_subtitle"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_hint"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Error State -->
                <LinearLayout
                    android:id="@+id/layoutError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xxl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/icon_xl"
                        android:layout_height="@dimen/icon_xl"
                        android:src="@drawable/ic_cloud_off"
                        android:contentDescription="@string/cd_error_icon"
                        app:tint="@color/error"
                        android:layout_marginBottom="@dimen/spacing_medium" />

                    <TextView
                        android:id="@+id/tvErrorMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/error_loading_drivers"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height_small"
                        android:text="@string/action_retry"
                        app:cornerRadius="@dimen/radius_small" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB visible only for admin -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddDriver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_medium"
        android:contentDescription="@string/cd_add_driver"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:backgroundTint="@color/primary"
        app:tint="@color/on_primary"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
