<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════
     COMPANY SETTINGS BOTTOM SHEET
     Allows the admin to update company information:
     name, address, phone, email, GST number.
     ═══════════════════════════════════════════════════════════ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvCompanySettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_company_edit_title"
        android:textSize="@dimen/text_title"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvCompanySettingsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_company_edit_subtitle"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="@dimen/spacing_large" />

    <!-- Company Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCompanyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/admin_company_name_hint"
        app:startIconDrawable="@drawable/ic_build"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCompanyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="Movexa Fleet" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Company Address Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCompanyAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/admin_company_address_hint"
        app:startIconDrawable="@drawable/ic_location"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCompanyAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:imeOptions="actionNext"
            tools:text="123 Fleet St, Mumbai" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Company Phone Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCompanyPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/admin_company_phone_hint"
        app:startIconDrawable="@drawable/ic_phone"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCompanyPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="+91 98765 43210" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Company Email Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCompanyEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/admin_company_email_hint"
        app:startIconDrawable="@drawable/ic_email"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCompanyEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="info@movexa.com" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- GST Number Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGstNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        style="@style/Widget.Movexa.TextInputLayout"
        android:hint="@string/admin_company_gst_hint"
        app:startIconDrawable="@drawable/ic_assignment"
        app:startIconTint="@color/primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGstNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:imeOptions="actionDone"
            tools:text="22AAAAA0000A1Z5" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveCompanySettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/admin_company_save"
        style="@style/Widget.Movexa.Button.Primary"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelCompanySettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/edit_profile_cancel"
        style="@style/Widget.Movexa.Button.Text"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressCompanySettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/loading_bar_height"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/primary_surface"
        tools:visibility="visible" />

</LinearLayout>
