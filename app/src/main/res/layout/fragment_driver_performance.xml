<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ════════════════════════════════════════════════════════ -->
    <!--  LOADING STATE                                          -->
    <!-- ════════════════════════════════════════════════════════ -->

    <FrameLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorSize="56dp"
                app:trackThickness="4dp"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/primary_surface"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perf_loading"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════ -->
    <!--  ERROR STATE                                            -->
    <!-- ════════════════════════════════════════════════════════ -->

    <FrameLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/screen_margin_horizontal">

            <ImageView
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:src="@drawable/ic_nav_alerts"
                android:contentDescription="@string/perf_error_title"
                app:tint="@color/text_hint"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perf_error_title"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perf_error_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_large" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/perf_retry"
                app:cornerRadius="@dimen/radius_large" />

        </LinearLayout>

    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════ -->
    <!--  EMPTY STATE                                            -->
    <!-- ════════════════════════════════════════════════════════ -->

    <FrameLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/screen_margin_horizontal">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_nav_performance"
                android:contentDescription="@string/perf_empty_title"
                app:tint="@color/text_hint"
                android:layout_marginBottom="@dimen/spacing_large" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perf_empty_title"
                android:textSize="@dimen/text_title"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perf_empty_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════ -->
    <!--  CONTENT - Swipe to Refresh                             -->
    <!-- ════════════════════════════════════════════════════════ -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_horizontal"
                android:paddingTop="@dimen/screen_margin_vertical">

                <!-- ══════════════════════════════════════════ -->
                <!--  SCORE CARD                                -->
                <!-- ══════════════════════════════════════════ -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="@dimen/elevation_small"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding"
                        android:gravity="center_horizontal">

                        <!-- Score Circle Container -->
                        <FrameLayout
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_marginBottom="@dimen/spacing_medium">

                            <!-- Background Ring Track -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressScoreTrack"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:progress="100"
                                app:indicatorSize="170dp"
                                app:trackThickness="10dp"
                                app:indicatorColor="@color/score_circle_track"
                                app:trackColor="@android:color/transparent"
                                app:trackCornerRadius="5dp" />

                            <!-- Animated Score Ring -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressScore"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:progress="0"
                                app:indicatorSize="170dp"
                                app:trackThickness="10dp"
                                app:indicatorColor="@color/score_excellent_ring"
                                app:trackColor="@android:color/transparent"
                                app:trackCornerRadius="5dp" />

                            <!-- Score Text -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvScoreValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="48sp"
                                    android:textColor="@color/score_circle_text"
                                    android:fontFamily="sans-serif-bold"
                                    tools:text="87" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perf_score_out_of"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/score_circle_label" />

                            </LinearLayout>

                        </FrameLayout>

                        <!-- Grade Badge -->
                        <TextView
                            android:id="@+id/tvGradeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_medium"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/score_excellent"
                            android:fontFamily="sans-serif-medium"
                            android:background="@drawable/bg_trend_badge"
                            android:layout_marginBottom="@dimen/spacing_small"
                            tools:text="Excellent Driver" />

                        <!-- Trend Badge -->
                        <TextView
                            android:id="@+id/tvTrendBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_small"
                            android:paddingVertical="@dimen/spacing_xxs"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/score_trend_up"
                            android:background="@drawable/bg_trend_badge"
                            tools:text="↑ Improving" />

                        <!-- Last Updated -->
                        <TextView
                            android:id="@+id/tvLastUpdated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_overline"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="@dimen/spacing_small"
                            tools:text="Last updated 5 min ago" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ══════════════════════════════════════════ -->
                <!--  STATISTICS GRID                           -->
                <!-- ══════════════════════════════════════════ -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perf_stats_title"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <LinearLayout
                    android:id="@+id/gridStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <!-- Row 1: Trips + Distance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_small">

                        <!-- Trips Stat -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatTrips"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            app:cardCornerRadius="@dimen/radius_medium"
                            app:cardElevation="@dimen/elevation_xs"
                            app:cardBackgroundColor="@color/surface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_medium">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_nav_trips"
                                    app:tint="@color/perf_stat_trips"
                                    android:background="@drawable/bg_perf_stat_icon"
                                    android:backgroundTint="@color/perf_stat_trips_bg"
                                    android:padding="8dp"
                                    android:contentDescription="@string/cd_perf_stat_icon"
                                    android:layout_marginBottom="@dimen/spacing_small" />

                                <TextView
                                    android:id="@+id/tvStatTripsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_title"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-bold"
                                    tools:text="42" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perf_stat_trips"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Distance Stat -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatDistance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_xs"
                            app:cardCornerRadius="@dimen/radius_medium"
                            app:cardElevation="@dimen/elevation_xs"
                            app:cardBackgroundColor="@color/surface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_medium">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_nav_tracking"
                                    app:tint="@color/perf_stat_distance"
                                    android:background="@drawable/bg_perf_stat_icon"
                                    android:backgroundTint="@color/perf_stat_distance_bg"
                                    android:padding="8dp"
                                    android:contentDescription="@string/cd_perf_stat_icon"
                                    android:layout_marginBottom="@dimen/spacing_small" />

                                <TextView
                                    android:id="@+id/tvStatDistanceValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_title"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-bold"
                                    tools:text="1,250" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perf_stat_distance"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Row 2: Hours + Mileage -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Hours Stat -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatHours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            app:cardCornerRadius="@dimen/radius_medium"
                            app:cardElevation="@dimen/elevation_xs"
                            app:cardBackgroundColor="@color/surface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_medium">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_alert_long_idle"
                                    app:tint="@color/perf_stat_hours"
                                    android:background="@drawable/bg_perf_stat_icon"
                                    android:backgroundTint="@color/perf_stat_hours_bg"
                                    android:padding="8dp"
                                    android:contentDescription="@string/cd_perf_stat_icon"
                                    android:layout_marginBottom="@dimen/spacing_small" />

                                <TextView
                                    android:id="@+id/tvStatHoursValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_title"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-bold"
                                    tools:text="86.5" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perf_stat_hours"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Mileage Stat -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatMileage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_xs"
                            app:cardCornerRadius="@dimen/radius_medium"
                            app:cardElevation="@dimen/elevation_xs"
                            app:cardBackgroundColor="@color/surface">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_medium">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_nav_fuel"
                                    app:tint="@color/perf_stat_mileage"
                                    android:background="@drawable/bg_perf_stat_icon"
                                    android:backgroundTint="@color/perf_stat_mileage_bg"
                                    android:padding="8dp"
                                    android:contentDescription="@string/cd_perf_stat_icon"
                                    android:layout_marginBottom="@dimen/spacing_small" />

                                <TextView
                                    android:id="@+id/tvStatMileageValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_title"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-bold"
                                    tools:text="12.4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perf_stat_mileage"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

                <!-- ══════════════════════════════════════════ -->
                <!--  SCORE BREAKDOWN                           -->
                <!-- ══════════════════════════════════════════ -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perf_breakdown_title"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/spacing_small" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="@dimen/elevation_xs"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <!-- Base Score Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/perf_breakdown_base"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvBreakdownBase"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                tools:text="100 pts" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="@dimen/spacing_small" />

                        <!-- Penalties Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/perf_breakdown_penalties"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvBreakdownPenalties"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/violation_penalty_text"
                                android:fontFamily="sans-serif-medium"
                                tools:text="-15 pts" />

                        </LinearLayout>

                        <!-- Trip Bonus Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_small">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/perf_breakdown_trip_bonus"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvBreakdownTripBonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/score_trend_up"
                                android:fontFamily="sans-serif-medium"
                                tools:text="+10 pts" />

                        </LinearLayout>

                        <!-- Fuel Bonus Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/perf_breakdown_fuel_bonus"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvBreakdownFuelBonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textColor="@color/score_trend_up"
                                android:fontFamily="sans-serif-medium"
                                tools:text="+6 pts" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ══════════════════════════════════════════ -->
                <!--  VIOLATIONS SECTION                        -->
                <!-- ══════════════════════════════════════════ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perf_violations_title"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvViolationsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        tools:text="12 total events" />

                </LinearLayout>

                <!-- No Violations State -->
                <TextView
                    android:id="@+id/tvNoViolations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perf_violations_none"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:padding="@dimen/spacing_large"
                    android:background="@drawable/bg_perf_empty_state"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:visibility="gone" />

                <!-- Violations RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvViolations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:clipToPadding="false" />

                <!-- ══════════════════════════════════════════ -->
                <!--  SUGGESTIONS SECTION                       -->
                <!-- ══════════════════════════════════════════ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perf_suggestions_title"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvSuggestionsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perf_suggestions_subtitle"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- Suggestions RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
