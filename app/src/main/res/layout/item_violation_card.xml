<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_xs"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium"
        android:gravity="center_vertical">

        <!-- Violation Type Icon -->
        <ImageView
            android:id="@+id/ivViolationIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/cd_perf_violation_icon"
            android:background="@drawable/bg_perf_stat_icon"
            tools:src="@drawable/ic_alert_type_overspeed" />

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvViolationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                tools:text="Overspeed" />

            <TextView
                android:id="@+id/tvViolationCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/spacing_xxs"
                tools:text="8 events" />

        </LinearLayout>

        <!-- Penalty Badge -->
        <TextView
            android:id="@+id/tvViolationPenalty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_penalty_badge"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/violation_penalty_text"
            android:fontFamily="sans-serif-medium"
            tools:text="-40 pts" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
